rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function hasValidAuth() {
      return request.auth != null;
    }

    function isAuthenticated() {
      return hasValidAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isBoardMember(boardId) {
      return isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/boards/$(boardId)).data.members;
    }

    function hasWritePermission(boardId) {
      let board = get(/databases/$(database)/documents/boards/$(boardId)).data;
      let role = board.permissions != null ? board.permissions[request.auth.uid] : 'editor';
      return isAuthenticated() && (request.auth.uid in board.members) && (role == 'owner' || role == 'admin' || role == 'editor');
    }

    // 🛡️ Boards
    match /boards/{boardId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.members;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && request.auth.uid in resource.data.members;
      allow delete: if isAuthenticated() && resource.data.permissions[request.auth.uid] == 'owner';
    }

    // 🛡️ Sub-coleção: Cards
    match /cards/{cardId} {
      allow read: if isAuthenticated() && isBoardMember(resource.data.boardId);
      allow create: if hasWritePermission(request.resource.data.boardId);
      allow update, delete: if hasWritePermission(resource.data.boardId);
    }
    
    // 🛡️ Outras Sub-coleções (Lists, Comments, Activities)
    match /lists/{listId} {
      allow read: if isAuthenticated() && isBoardMember(resource.data.boardId);
      allow create: if hasWritePermission(request.resource.data.boardId);
      allow update, delete: if hasWritePermission(resource.data.boardId);
    }
    match /comments/{commentId} {
      allow read: if isAuthenticated() && isBoardMember(resource.data.boardId);
      allow create: if hasWritePermission(request.resource.data.boardId);
      allow update, delete: if hasWritePermission(resource.data.boardId);
    }
    // 🛡️ Atividades
    match /activities/{activityId} {
      allow read: if isAuthenticated() && isBoardMember(resource.data.boardId);
      allow create: if hasWritePermission(request.resource.data.boardId);
      allow update, delete: if hasWritePermission(resource.data.boardId);
    }

    // 🛡️ Notificações (acessível apenas ao destinatário)
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 🛡️ Presença (Permite que membros vejam quem está online)
    match /presence/{presenceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && presenceId == request.auth.uid;
    }

    // 🛡️ Profiles de Usuários (Dados Públicos Estritos)
    match /users/{userId} {
      // Whitelist de campos: Apenas estes campos podem ser lidos por terceiros
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // 🛡️ Dados Privados (Somente o próprio usuário)
    match /userPrivate/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // 🛡️ Lookup de Convites (Apenas para busca de UID por email)
    match /userLookup/{email} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }
  }

  // Funções Auxiliares
  function isAuthenticated() {
    return request.auth != null;
  }

  function isBoardMember(boardId) {
    return isAuthenticated() && 
      exists(/databases/$(database)/documents/boards/$(boardId)) &&
      request.auth.uid in get(/databases/$(database)/documents/boards/$(boardId)).data.members;
  }

  function hasWritePermission(boardId) {
    let board = get(/databases/$(database)/documents/boards/$(boardId));
    let role = board.data.permissions[request.auth.uid];
    return role == 'owner' || role == 'admin' || role == 'editor';
  }
}
